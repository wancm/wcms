<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    xunit and the test SDK only. Fakes are hand-rolled rather than generated by a mocking
    framework, so the test doubles are as readable as the code they stand in for.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    References all four so the architecture test can inspect the real assemblies.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ContentImporter.Domain\ContentImporter.Domain.csproj" />
    <ProjectReference Include="..\..\src\ContentImporter.Application\ContentImporter.Application.csproj" />
    <ProjectReference Include="..\..\src\ContentImporter.Infrastructure\ContentImporter.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ContentImporter.Console\ContentImporter.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
